{
  "name": "tina-remix-starter",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-cloudflare-build-env.mjs && tinacms build -c \"react-router build\"",
    "build-local": "tinacms build --local --skip-cloud-checks -c \"react-router build\"",
    "dev": "tinacms dev -c \"react-router dev\"",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "@vercel/react-router": "1.3.7",
    "isbot": "^5.2.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-router": "7.18.5",
    "tinacms": "^3.10.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@react-router/dev": "7.18.5",
    "@react-router/fs-routes": "7.18.5",
    "@tinacms/cli": "^2.5.3",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^4.3.2",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "packageManager": "pnpm@10.34.9",
  "cloudflare": {
    "bindings": {
      "TINA_CLIENT_ID": {
        "description": "Client ID from your project at app.tina.io. Also add it as a build variable (Worker > Settings > Build > Build Variables and Secrets) so the build can use it."
      },
      "TINA_TOKEN": {
        "description": "Read-only token from your project at app.tina.io. Also add it as a build variable (Worker > Settings > Build > Build Variables and Secrets) so the build can use it."
      },
      "TINA_BRANCH": {
        "description": "Optional. The branch TinaCMS edits. Leave empty to use the branch Cloudflare builds."
      }
    }
  }
}
